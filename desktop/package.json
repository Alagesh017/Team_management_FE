{
  "name": "dce-task-manager-desktop",
  "version": "1.0.1",
  "description": "Dce task manager — desktop app with built-in activity monitoring",
  "main": "main.js",
  "author": "DCE",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Alagesh017/Team_management_FE.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "clean": "node scripts/prebuild-clean.js",
    "predist": "node scripts/prebuild-clean.js",
    "prepack": "node scripts/prebuild-clean.js",
    "pack": "node scripts/run-dist.js --dir",
    "dist": "node scripts/run-dist.js",
    "dist:publish": "node scripts/run-dist.js --publish"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "serve-handler": "^6.1.6"
  },
  "build": {
    "appId": "com.dce.taskmanager",
    "productName": "Dce task manager",
    "icon": "image.png",
    "directories": {
      "output": "installer-output"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Alagesh017",
        "repo": "Team_management_FE"
      }
    ],
    "files": [
      "**/*",
      "!scripts/**",
      "!installer-output/**",
      "!README.md",
      "!.env",
      "!.env.example",
      "!.env.production",
      "!.builder-output-dir"
    ],
    "extraResources": [
      {
        "from": ".env.production",
        "to": "app-config.env"
      },
      {
        "from": ".env.production",
        "to": "monitor-agent/.env"
      },
      {
        "from": "../dist-desktop",
        "to": "web-app",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../employee-monitor-agent/src",
        "to": "monitor-agent/src",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../employee-monitor-agent/config.default.js",
        "to": "monitor-agent/config.default.js"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "DceTaskManager-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Dce task manager"
    },
    "protocols": [
      {
        "name": "EduCER Monitor",
        "schemes": [
          "educermonitor"
        ]
      }
    ]
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
